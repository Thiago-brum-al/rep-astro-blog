---
import Image from "astro/components/Image.astro";

interface Props {
  id: string;
  name: string;
  avatar: ImageMetadata;
  twitter: string;
  linkedIn: string;
  github: string;
  bio: string;
  subtitle: string;
}

const { id, avatar, bio, github, linkedIn, name, subtitle, twitter } = Astro.props;
---

<div class="max-w-lg mx-auto my-10 bg-white rounded-lg shadow-md p-5">
  <Image
    height={50}
    width={50}
    class="w-32 h-32 rounded-full mx-auto"
    src={avatar}
    alt="Profile picture"
  />
  <h2 class="text-center text-2xl font-semibold mt-3">{name}</h2>
  <p class="text-center text-gray-600 mt-1">{subtitle}</p>
  <div class="flex justify-center mt-5">
    <a href={twitter} class="text-blue-500 hover:text-blue-700 mx-3">Twitter</a>
    <a href={linkedIn} class="text-blue-500 hover:text-blue-700 mx-3"
      >LinkedIn</a
    >
    <a href={github} class="text-blue-500 hover:text-blue-700 mx-3">GitHub</a>
  </div>
  <div class="mt-5">
    <h3 class="text-xl font-semibold">Bio</h3>
    <p class="text-gray-600 mt-2">
      {bio}
    </p>
  </div>
  <div class="flex items-center justify-end">
    <a href=`/authors/${id}` target="_self" rel="noopener noreferrer">
    Read more</a>
  </div>
</div>